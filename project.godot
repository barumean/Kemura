; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kemura"
config/description="Emuera era-script game emulator for Android"
config/version="0.3.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

; 기준 해상도. canvas_items 스트레치는 이 크기로 UI를 그린 뒤 화면에 맞춰
; 확대한다. 1080 기준이면 최신 폰(1440 이상)에서 버튼이 물리적으로 너무 작아
; 터치하기 어렵다(권장 최소 터치 영역 48dp ≈ 9mm).
; 720 기준으로 낮추면 같은 픽셀 수의 UI가 1.5배 크게 표시된다.
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="Kemura"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[android]

enabled=true
