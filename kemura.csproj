<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <!--
      Godot 4.7 의 .NET 에디션은 net9.0 을 전제로 빌드/내보내기한다.
      에디터가 기대하는 TFM 과 일치시켜야 한다.

      예전에 여기에는 "GodotSharp 가 lib/net8.0 만 제공하므로 net8.0" 이라고
      적혀 있었지만 이는 틀렸다. net9.0 프로젝트는 net8.0 라이브러리를 그대로
      참조할 수 있으므로, lib/net8.0 의 존재는 프로젝트 쪽 TFM 을 net8.0 으로
      묶을 근거가 되지 않는다.
    -->
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!--
      project.godot 의 [dotnet] project/assembly_name="Kemura" 와 반드시 일치해야 한다.
      지정하지 않으면 MSBuild가 프로젝트 파일명(kemura.csproj)을 써서 kemura.dll 을
      만들고, Godot은 Kemura.dll 을 찾으므로 어셈블리를 로드하지 못한다.
      그 결과 모든 C# 스크립트가
        "Cannot instantiate C# script because the associated class could not be found"
      로 실패해 화면에 아무것도 뜨지 않는다.

      Windows는 대소문자를 구분하지 않아 우연히 동작했지만,
      Linux와 Android는 구분하므로 실기에서만 깨졌다.
    -->
    <AssemblyName>Kemura</AssemblyName>
    <RootNamespace>Kemura</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    SQLite 의존은 삭제했다.
    Microsoft.Data.Sqlite / SQLitePCLRaw 를 참조하고 있었지만, 저장소 전체에
    SQLite 를 쓰는 코드는 한 줄도 없었고 참조하던 addons/sqlite/... 경로도
    존재하지 않았다. APK 만 불필요하게 키우고, 16KB 정렬되지 않은 네이티브
    .so 를 끌어들이는 위험만 있었다.
  -->
</Project>
