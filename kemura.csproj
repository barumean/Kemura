<Project Sdk="Godot.NET.Sdk/4.6.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition="'$(GodotTargetPlatform)' == 'android'">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Kemura</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.6" />
  </ItemGroup>

  <!-- Android: native SQLite library -->
  <ItemGroup Condition="'$(GodotTargetPlatform)' == 'android'">
    <None Include="addons/sqlite/android/arm64-v8a/libe_sqlite3.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopySqliteNativeLib"
          AfterTargets="Build"
          Condition="'$(GodotTargetPlatform)' == 'android' AND Exists('addons/sqlite/android/arm64-v8a/libe_sqlite3.so')">
    <Copy SourceFiles="addons/sqlite/android/arm64-v8a/libe_sqlite3.so"
          DestinationFolder="$(OutputPath)/arm64-v8a/" />
  </Target>
</Project>
